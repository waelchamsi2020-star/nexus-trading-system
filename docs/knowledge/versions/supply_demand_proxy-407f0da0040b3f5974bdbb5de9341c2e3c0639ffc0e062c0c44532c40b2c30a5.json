    "direct_broker_authority": false,
    "promotion_policy": "versioned code change plus tests; never automatic self-modification",
    "data_policy": "MT5_ONLY",
    "external_model_api_required": false,
    "price_plan": "closed-bar entry zone +/- 0.15 ATR; structural stop buffered 0.1 ATR; default 2R or explicit model target",
    "portfolio_authority": "independent shared daily risk; no agent may alter limits",
    "executable_specialists": []
  },
  "conditions_code": [
    "result['direction'] == 'BUY'",
    "b[-1]['close'] <= mean",
    "result['direction'] == 'SELL'",
    "b[-1]['close'] >= mean"
  ],
  "algorithm_python": "def supply_zone(b,c):\n    result=first_return(b,\"base\")\n    if not result[\"triggered\"]:return result\n    mean=st.ema([x[\"close\"] for x in b[:-1]],20)[-1]\n    if (result[\"direction\"]==\"BUY\" and b[-1][\"close\"]<=mean) or (result[\"direction\"]==\"SELL\" and b[-1][\"close\"]>=mean):\n        return wait(b)\n    result[\"assumptions\"].append(\"First-return OHLC zone with prior EMA filter; not observed supply or demand orders\")\n    return result\n",
