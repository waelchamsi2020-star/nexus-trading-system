    "executable_specialists": []
  },
  "conditions_code": [
    "means[-1] > means[-2]",
    "b[-2]['close'] <= hi < b[-1]['close']",
    "means[-1] < means[-2]",
    "b[-2]['close'] >= lo > b[-1]['close']"
  ],
  "algorithm_python": "@specialist(\"atr_channel_break\", \"اختراق قناة التقلب\", \"ATR channel breakout\", \"volatility\",\n            [\"Fixed prior EMA20 +/- 2 prior ATR14\", \"Fresh close through channel in matching EMA direction\"],\n            {\"ema\": 20, \"atr\": 14, \"multiplier\": 2}, (\"TREND\", \"MIXED\"))\ndef atr_channel_break(b, c):\n    means = ema([x[\"close\"] for x in b[:-1]], 20)\n    center, width = means[-1], 2*atr(b[:-1])\n    hi, lo = center+width, center-width\n    return signal(b, means[-1] > means[-2] and b[-2][\"close\"] <= hi < b[-1][\"close\"],\n                  means[-1] < means[-2] and b[-2][\"close\"] >= lo > b[-1][\"close\"], center, center, dict(mean=center, high=hi, low=lo))\n",
