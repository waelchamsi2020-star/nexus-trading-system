  "conditions_code": [
    "prev['close'] < prev['open']",
    "now['close'] > now['open']",
    "now['open'] <= prev['close']",
    "now['close'] >= prev['open']",
    "prev['close'] > prev['open']",
    "now['close'] < now['open']",
    "now['open'] >= prev['close']",
    "now['close'] <= prev['open']",
    "size >= 0.5 * c['atr']",
    "side != 'NEUTRAL'"
  ],
  "algorithm_python": "@_register(\"engulfing\", \"حركة السعر والشموع\", [\"body engulfing\"], \"candle\", 20)\ndef engulfing(b, c):\n    prev, now = b[-2:]\n    bull = prev[\"close\"] < prev[\"open\"] and now[\"close\"] > now[\"open\"] and now[\"open\"] <= prev[\"close\"] and now[\"close\"] >= prev[\"open\"]\n    bear = prev[\"close\"] > prev[\"open\"] and now[\"close\"] < now[\"open\"] and now[\"open\"] >= prev[\"close\"] and now[\"close\"] <= prev[\"open\"]\n    size = abs(now[\"close\"]-now[\"open\"])\n    valid = size >= .5*c[\"atr\"] and (bull or bear)\n    side = \"BUY\" if bull else \"SELL\" if bear else \"NEUTRAL\"\n    return _result(side, valid, now[\"close\"], min(prev[\"low\"], now[\"low\"]) if bull else max(prev[\"high\"], now[\"high\"]),\n                   [_evidence(\"candle\", size, b, \"engulfing body / ATR\", ratio=size/max(c[\"atr\"], 1e-12))],\n                   [\"engulfing body\"] if side != \"NEUTRAL\" else [], [] if valid else [\"body >= 0.5 ATR and engulfing\"])\n",
