    "definition": {
      "name_en": "Failed range breakout",
      "rules": [
        "Sweep prior 20-bar boundary and close back inside",
        "Close in inner 60% of bar toward reversal; reject simultaneous two-edge sweeps"
      ],
      "parameters": {
        "lookback": 20,
        "close_fraction": 0.6
      },
      "allowed_regimes": [
        "RANGE",
        "MIXED"
      ],
      "timeframe_scope": "all_completed_ohlc",
      "rules_ar": [
        "تجاوز طرف نطاق العشرين شمعة السابقة ثم إغلاق داخل النطاق.",
        "الإغلاق ضمن ستين بالمئة من الشمعة باتجاه العودة؛ تجاوز الطرفين معًا مرفوض."
      ]
    },
    "missing_data_policy": "abstain",
    "direct_broker_authority": false,
    "promotion_policy": "versioned code change plus tests; never automatic self-modification",
    "data_policy": "MT5_ONLY",
    "external_model_api_required": false,
    "price_plan": "closed-bar entry zone +/- 0.15 ATR; structural stop buffered 0.1 ATR; default 2R or explicit model target",
    "portfolio_authority": "independent shared daily risk; no agent may alter limits",
    "executable_specialists": []
  },
  "conditions_code": [
    "x['low'] < lo < x['close'] < hi",
    "x['high'] <= hi",
    "x['close'] - x['low'] >= 0.6 * span",
    "x['high'] > hi > x['close'] > lo",
    "x['low'] >= lo",
    "x['high'] - x['close'] >= 0.6 * span"
  ],
  "algorithm_python": "@specialist(\"failed_range_break\", \"فشل اختراق النطاق\", \"Failed range breakout\", \"structure\",\n            [\"Sweep prior 20-bar boundary and close back inside\", \"Close in inner 60% of bar toward reversal; reject simultaneous two-edge sweeps\"],\n            {\"lookback\": 20, \"close_fraction\": .6}, (\"RANGE\", \"MIXED\"))\ndef failed_range_break(b, c):\n    p, x = b[-21:-1], b[-1]\n    hi, lo = max(z[\"high\"] for z in p), min(z[\"low\"] for z in p)\n    span = x[\"high\"]-x[\"low\"]\n    bull = x[\"low\"] < lo < x[\"close\"] < hi and x[\"high\"] <= hi and x[\"close\"]-x[\"low\"] >= .6*span\n    bear = x[\"high\"] > hi > x[\"close\"] > lo and x[\"low\"] >= lo and x[\"high\"]-x[\"close\"] >= .6*span\n    return signal(b, bull, bear, x[\"low\"], x[\"high\"], {\"high\": hi, \"low\": lo})\n",
