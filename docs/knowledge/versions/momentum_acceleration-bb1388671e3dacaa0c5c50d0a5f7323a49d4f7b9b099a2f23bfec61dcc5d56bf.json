        "اتجاه العبور يوافق ميل المتوسط الأسي السابق."
      ]
    },
    "missing_data_policy": "abstain",
    "direct_broker_authority": false,
    "promotion_policy": "versioned code change plus tests; never automatic self-modification",
    "data_policy": "MT5_ONLY",
    "external_model_api_required": false,
    "price_plan": "closed-bar entry zone +/- 0.15 ATR; structural stop buffered 0.1 ATR; default 2R or explicit model target",
    "portfolio_authority": "independent shared daily risk; no agent may alter limits",
    "executable_specialists": []
  },
  "conditions_code": [
    "scale <= 0",
    "previous <= 2 < current",
    "means[-1] > means[-2]",
    "previous >= -2 > current",
    "means[-1] < means[-2]"
  ],
  "algorithm_python": "@specialist(\"momentum_acceleration\", \"تسارع الزخم السعري\", \"Normalized momentum acceleration\", \"momentum\",\n            [\"20-bar price change freshly crosses +/- 2 prior ATR\", \"Sign agrees with prior EMA20 slope\"],\n            {\"lookback\": 20, \"threshold_atr\": 2, \"ema\": 20}, (\"TREND\", \"MIXED\"))\ndef momentum_acceleration(b, c):\n    scale = atr(b[:-1])\n    if scale <= 0:\n        return signal(b, False, False, None, None, {\"scale\": scale})\n    previous, current = (b[-2][\"close\"]-b[-22][\"close\"])/scale, (b[-1][\"close\"]-b[-21][\"close\"])/scale\n    means = ema([x[\"close\"] for x in b[:-1]], 20)\n    return signal(b, previous <= 2 < current and means[-1] > means[-2], previous >= -2 > current and means[-1] < means[-2],\n                  min(x[\"low\"] for x in b[-5:]), max(x[\"high\"] for x in b[-5:]), {\"previous\": previous, \"current\": current})\n",
